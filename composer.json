{
    "name": "visualbuilder/filament-screenshot-review",
    "description": "Human QA review for Filament v5 screenshot catalogues — approve, request changes, and file tickets per capture.",
    "keywords": [
        "visualbuilder",
        "filament",
        "screenshots",
        "qa",
        "visual-regression",
        "agentic"
    ],
    "homepage": "https://github.com/visualbuilder/filament-screenshot-review",
    "license": "GPL-2.0-or-later",
    "type": "library",
    "authors": [
        {
            "name": "Visual Builder",
            "email": "support@ekouk.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/bus": "^11.0 || ^12.0",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/database": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "pestphp/pest-plugin-livewire": "^3.0 || ^4.0",
        "visualbuilder/filament-panel-screenshot-catalogue": "*"
    },
    "autoload": {
        "psr-4": {
            "Visualbuilder\\FilamentScreenshotReview\\": "src",
            "Visualbuilder\\FilamentScreenshotReview\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Visualbuilder\\FilamentScreenshotReview\\Tests\\": "tests",
            "Visualbuilder\\FilamentScreenshotReview\\Tests\\Fixtures\\": "tests/Fixtures"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Visualbuilder\\FilamentScreenshotReview\\FilamentScreenshotReviewServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
